# Copie este arquivo para .env e ajuste os valores conforme o ambiente.
# Não versionar o arquivo .env com credenciais reais.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=igreja_db
DB_USER=igreja
DB_PASSWORD=altere_esta_senha
# Fora do perfil dev/test a API recusa subir com o default do application.yml.
JWT_SECRET=altere-para-um-segredo-longo-e-aleatorio-com-pelo-menos-32-caracteres
JWT_EXPIRATION_MS=14400000
SERVER_PORT=8080
# Origens do frontend React (localhost em dev + domínio de produção). Sem "*".
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*

# Primeiro administrador (fora do perfil dev). Só é criado se o banco não tiver nenhum usuário:
# ganha os papéis ADMIN + PASTOR na igreja matriz. Depois do primeiro login, remova ADMIN_SENHA.
# ADMIN_USERNAME=pastor
# ADMIN_EMAIL=pastor@suaigreja.com.br
# ADMIN_SENHA=uma-senha-forte-com-8-ou-mais
# ADMIN_NOME=Nome do Pastor

# dev = seed + Swagger público; em produção use outro perfil (ex.: prod).
SPRING_PROFILES_ACTIVE=dev

# Fuso dos agendamentos (aniversário, automação de cultos e escalas).
APP_TIMEZONE=America/Sao_Paulo

# Mensagem de aniversário (cron Spring: seg min hora dia mês dia-semana).
MESSAGE_ANIVERSARIO_ATIVO=true
MESSAGE_ANIVERSARIO_CRON=0 0 12 * * *
# Placeholders: {primeiroNome}, {igreja}. Deixe comentado para usar o texto padrão.
# MESSAGE_ANIVERSARIO_TEMPLATE=Feliz aniversário, {primeiroNome}! Com carinho, {igreja}.

# WhatsApp (Evolution API). Com false a mensagem só vai para o log e o envio fica como FALHA.
# Com true, URL_BASE, API_KEY e INSTANCIA são obrigatórios (a API não sobe sem eles).
WHATSAPP_HABILITADO=false
WHATSAPP_URL_BASE=https://evolution.seudominio.com.br
WHATSAPP_API_KEY=
WHATSAPP_INSTANCIA=
WHATSAPP_DELAY_MS=1200

# RabbitMQ: false = envio síncrono (sem broker); true = fila (o docker-compose já sobe o broker).
RABBIT_HABILITADO=false
RABBIT_HOST=localhost
RABBIT_PORT=5672
RABBIT_USER=guest
RABBIT_PASSWORD=guest
