# Copie para deploy/.env no servidor (não versionar) e carregue antes do deploy:
#   set -a; . deploy/.env; set +a
#   docker stack deploy --with-registry-auth -c deploy/stack.yml base-api
# O arquivo é lido pelo shell: valores com espaço (ADMIN_NOME, o cron) precisam de aspas.

API_IMAGE=ghcr.io/base-church-porto-nacional/base_api:latest
API_HOST=api.veigagustavo.com.br
CORS_ALLOWED_ORIGIN_PATTERNS=https://base.veigagustavo.com.br

TRAEFIK_NETWORK=traefik-public
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

DB_NAME=igreja_db
DB_USER=igreja
# openssl rand -hex 24
DB_PASSWORD=
# openssl rand -hex 48
JWT_SECRET=
JWT_EXPIRATION_MS=14400000

# Primeiro administrador: só é criado com o banco vazio. Remova ADMIN_SENHA após o primeiro login.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_SENHA=
ADMIN_NOME=""

APP_TIMEZONE=America/Sao_Paulo
MESSAGE_ANIVERSARIO_ATIVO=true
MESSAGE_ANIVERSARIO_CRON="0 0 12 * * *"

WHATSAPP_HABILITADO=false
WHATSAPP_URL_BASE=
WHATSAPP_API_KEY=
WHATSAPP_INSTANCIA=
WHATSAPP_DELAY_MS=1200
